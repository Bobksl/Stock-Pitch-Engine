# Copy this file to .env and fill in your values. Never commit .env.

# ============================================================================
# LLM — the generation/summarization model.
# Works with ANY provider that speaks the OpenAI chat-completions API:
# just set the base URL, model name, and key. (Embeddings are separate and
# always run locally — see the bottom of this file.)
# ============================================================================
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Optional tuning:
# LLM_MAX_TOKENS=5000          # per-answer output budget; raise for "reasoning" models that
#                              # spend tokens on hidden thinking before replying
# LLM_SECTION_TEXT_CAP=300000  # max chars sent to the summarizer per section (~4 chars/token);
#                              # lower to ~60000 if your model has a small (<32k-token) context

# ---- Example providers (pick one: set LLM_BASE_URL + LLM_MODEL + LLM_API_KEY) ----
#   DeepSeek     LLM_BASE_URL=https://api.deepseek.com          LLM_MODEL=deepseek-v4-flash
#   OpenAI       LLM_BASE_URL=https://api.openai.com/v1         LLM_MODEL=gpt-4o-mini
#   OpenRouter   LLM_BASE_URL=https://openrouter.ai/api/v1      LLM_MODEL=openai/gpt-4o-mini
#   Groq         LLM_BASE_URL=https://api.groq.com/openai/v1    LLM_MODEL=llama-3.3-70b-versatile
#   Together     LLM_BASE_URL=https://api.together.xyz/v1       LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
#   Mistral      LLM_BASE_URL=https://api.mistral.ai/v1         LLM_MODEL=mistral-large-latest
#   Ollama       LLM_BASE_URL=http://localhost:11434/v1         LLM_MODEL=llama3.1        (LLM_API_KEY=ollama)
#   LM Studio    LLM_BASE_URL=http://localhost:1234/v1          LLM_MODEL=<loaded-model>  (LLM_API_KEY=lm-studio)

# ============================================================================
# PostgreSQL + pgvector (see SETUP.md for the Docker one-liner)
# ============================================================================
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=filings
PGUSER=postgres
PGPASSWORD=

# ============================================================================
# Embeddings — always local (sentence-transformers on CPU). Free, private, and
# independent of your LLM provider. If you change the model, EMBEDDING_DIM must
# match its output size AND the vector(N) column in schema.sql.
# ============================================================================
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ---- Optional OCR / PDF tool paths (defaults in src/config.py; Windows shown) ----
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_DIR=C:\tools\tessdata
# POPPLER_PATH=C:\tools\poppler\Library\bin
